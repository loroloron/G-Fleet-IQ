{
  "expo": {
    "name": "G Fleet IQ",
    "slug": "g-fleet-iq-mobile",
    "scheme": "gfleetiq",
    "version": "1.0.0",
    "orientation": "default",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.loroloron.gfleetiq",
      "supportsTablet": true,
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.loroloron.gfleetiq"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "G Fleet IQ uses tablet location to detect when driving starts while the driver app is open."
        }
      ]
    ]
  }
}
